# Moodle LMS Checker - Environment Configuration
# Copy file ini menjadi .env dan isi dengan nilai yang sebenarnya
# JANGAN commit file .env ke git

MOODLE_URL=https://lms2.sains.ac.id
MOODLE_TOKEN=

# Semester code (2026/2027 Ganjil = 20261)
SEMESTER_CODE=20261

# Filter settings
ALLOWED_ROOMS=R2A,R2B,R2C

# API settings
API_TIMEOUT=30
API_RETRY_COUNT=3
API_RETRY_DELAY=2

# Cache settings
CACHE_ENABLED=true
CACHE_DIR=.cache

# Output settings
OUTPUT_DIR=output
